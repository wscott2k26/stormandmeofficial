{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "builder": {
      "root": "./",
      "framework": null,
      "installCommand": "echo 'SRG Android builder: install handled by build script'",
      "buildCommand": "bash ci/vercel-srg-android-build.sh",
      "outputDirectory": "android-artifacts"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "builder"
      }
    }
  ]
}