{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "create-react-app",
      "installCommand": "yarn install",
      "buildCommand": "yarn build",
      "outputDirectory": "build"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "server:app"
    }
  },
  "redirects": [
    {
      "source": "/delete-account",
      "destination": "/reppurpose/delete-account.html",
      "permanent": true
    },
    {
      "source": "/delete-account/",
      "destination": "/reppurpose/delete-account.html",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "https://storm-and-me-official.printify.me",
      "permanent": true
    },
    {
      "source": "/shop/:path*",
      "destination": "https://shop.stormandmeofficial.com/collections/all",
      "permanent": true
    },
    {
      "source": "/products/:path*",
      "destination": "https://storm-and-me-official.printify.me",
      "permanent": true
    },
    {
      "source": "/collections/:path*",
      "destination": "https://storm-and-me-official.printify.me",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "https://storm-and-me-official.printify.me",
      "permanent": false
    },
    {
      "source": "/account",
      "destination": "https://storm-and-me-official.printify.me",
      "permanent": false
    },
    {
      "source": "/checkout",
      "destination": "https://shop.stormandmeofficial.com/cart",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/iam/internal-prototype",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
